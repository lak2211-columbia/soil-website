# Environment variables for SOIL. On Vercel, set these under Project → Settings → Environment
# Variables. Locally, `npm run db:start` writes a .env.local with working development values.

# Postgres. Added automatically when you connect a database under Storage (Neon or similar).
DATABASE_URL=

# Admin login: your password, and a random secret of 32+ characters for signing the session cookie.
# Generate a secret with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_PASSWORD=
SESSION_SECRET=

# Image uploads. Added automatically when you create a Blob store under Storage.
BLOB_READ_WRITE_TOKEN=

# The public address, used in email links.
SITE_URL=https://www.soilmag.com

# Newsletter sending through Resend (resend.com). The From address must be on a domain you've
# verified with Resend, e.g. letter@soilmag.com.
RESEND_API_KEY=
NEWSLETTER_FROM=SOIL <letter@soilmag.com>
